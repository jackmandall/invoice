function gbp(n) { return "\u00a3" + (Math.round((n + Number.EPSILON) * 100) / 100).toLocaleString("en-GB", {minimumFractionDigits: 2, maximumFractionDigits: 2}); }

// First year VED table - 2026/27 (effective 1 April 2026)
// Source: gov.uk V149 / RAC, cross checked with embedded Excel RFL sheet
// Petrol, RDE2 diesel, alternative fuel and zero emission cars (TC48 / TC49 RDE2)
const VED_TABLE_2026 = [
  {min: 0,   max: 0,    rate: 10,    label: "0 g/km"},
  {min: 1,   max: 50,   rate: 115,   label: "1 to 50 g/km"},
  {min: 51,  max: 75,   rate: 135,   label: "51 to 75 g/km"},
  {min: 76,  max: 90,   rate: 280,   label: "76 to 90 g/km"},
  {min: 91,  max: 100,  rate: 365,   label: "91 to 100 g/km"},
  {min: 101, max: 110,  rate: 405,   label: "101 to 110 g/km"},
  {min: 111, max: 130,  rate: 455,   label: "111 to 130 g/km"},
  {min: 131, max: 150,  rate: 560,   label: "131 to 150 g/km"},
  {min: 151, max: 170,  rate: 1410,  label: "151 to 170 g/km"},
  {min: 171, max: 190,  rate: 2270,  label: "171 to 190 g/km"},
  {min: 191, max: 225,  rate: 3420,  label: "191 to 225 g/km"},
  {min: 226, max: 255,  rate: 4850,  label: "226 to 255 g/km"},
  {min: 256, max: 9999, rate: 5690,  label: "Over 255 g/km"}
];

function lookupVed(co2) {
  const c = Math.max(0, Math.round(Number(co2) || 0));
  for (const b of VED_TABLE_2026) {
    if (c >= b.min && c <= b.max) return b;
  }
  return VED_TABLE_2026[VED_TABLE_2026.length - 1];
}

function updateVedDisplay() {
  const el = document.getElementById("vedDisplay");
  if (!el) return;
  const co2 = reviewData.emissions || 0;
  const b = lookupVed(co2);
  el.innerHTML = `${gbp(b.rate)} <span style="color:var(--muted); font-weight:400; font-size:11px;">(${b.label})</span>`;
}

function updateTotals() {
  if (mode === "new") updateVedDisplay();
  const t = $("#totals");
  if (!t) return;
  const d = reviewData;
  if (mode === "new") {
    const ved = lookupVed(d.emissions || 0).rate;
    const total = d.newCarPrice + d.lessDiscount + d.tracker + d.gtechniq - d.pcgbContribution;
    const vat = (d.newCarPrice + d.lessDiscount + d.gtechniq + d.tracker - d.pcgbContribution) * 0.2;
    const grand = total + vat + ved + d.firstRegFee + d.gap - d.pfsDeposit;
    t.innerHTML = `
      <div class="row"><span>Total (ex VAT)</span><strong>${gbp(total)}</strong></div>
