  const list = $("#filesList");
  list.innerHTML = "";
  for (let i = 0; i < files.length; i++) {
    const f = files[i];
    const row = document.createElement("div");
    row.className = "file-chip";
    row.innerHTML = `
      <span class="name">${f.name}</span>
      <span class="type ${f.type}">${typeLabel(f.type)}</span>
      <button data-idx="${i}">Remove</button>
    `;
    list.appendChild(row);
  }
  list.querySelectorAll("button").forEach(b => b.onclick = () => {
    files.splice(parseInt(b.dataset.idx), 1);
    renderFiles();
    classifyAndPrepare();
  });
}

function classifyAndPrepare() {
  // Decide mode
  const types = files.map(f => f.type);
  const hasNewOrder = types.includes("new-order");
  const hasBuild = types.includes("build");
  const hasUsedOrder = types.includes("used-order");
  if (hasUsedOrder) {
    mode = "used";
  } else if (hasNewOrder || hasBuild) {
    mode = "new";
  } else {
    mode = null;
  }
  if (!mode) {
    $("#reviewPanel").classList.add("hidden");
    return;
  }
  // Combine extracted data
  if (mode === "new") {
    const orderFile = files.find(f => f.type === "new-order");
    const buildFile = files.find(f => f.type === "build");
    const orderData = orderFile ? orderFile.data : {};
    const buildData = buildFile ? buildFile.data : {};
    reviewData = combineNew(orderData, buildData);
  } else {
    const usedFile = files.find(f => f.type === "used-order");
    reviewData = combineUsed(usedFile.data);
  }
  renderReviewForm();
  $("#reviewPanel").classList.remove("hidden");
}

function combineNew(order, build) {
  // Customer fields from order form
  const addrJoined = (order.address || []).join(", ");
  // Skip the salutation name line (e.g. "Mr. Steve Nutbeam") and the country
  const addrFiltered = (order.address || []).filter((l, i) => {
    return !/^M[rs]+\.?\s/.test(l) && !/Great Britain/.test(l);
  });
  const postCode = addrFiltered.length ? addrFiltered[addrFiltered.length - 1] : "";
  const addressStreet = addrFiltered.slice(0, -1).join(", ");
  return {
    name: order.name || build.customerName || "",
    soldTo: "Individual",
    address: addressStreet,
    postCode: postCode,
    tel: order.tel || "",
    email: order.email || "",
    carModel: mapToParamModel(order.model || build.modelName || "", build.generation, false),
    emissions: 240,
    deliveryDay: 15, deliveryMonth: "May", deliveryYear: new Date().getFullYear(),
    invoiceDay: 15, invoiceMonth: "May", invoiceYear: new Date().getFullYear(),
    newCarPrice: (order.modelPrice || build.basePrice || 0) + (order.vehicleOptions || 0),
    lessDiscount: -(order.dealerDeductionsTaxable || 0),
    discountReason: "Centre Gesture",
    pcgbContribution: 0,
    pfsDeposit: 0,
    tracker: 0,
    gtechniq: 0,
    gap: 0,
    firstRegFee: order.regFee || 55,
    deposits: order.deposit || 0,
    financeAmount: 0,
    expectedTotal: order.totalPrice
  };
}

function combineUsed(used) {
  // Customer
  const addrJoined = (used.addressLines || []).join(", ");
  // post code typically last line / after final comma
  let postCode = "";
  let address = addrJoined;
  const pcM = addrJoined.match(/,\s*([A-Z]{1,2}\d{1,2}[A-Z]?\s+\d[A-Z]{2})\s*$/);
  if (pcM) {
    postCode = pcM[1];
    address = addrJoined.replace(pcM[0], "").trim();
  }
  // Strip "Mr X" salutation off the start of name
  let name = used.name || "";
  // Build car model string
  const makeM = (used.makeModel || "").replace(/^Porsche\s+/i, "").replace(/\s*\[\s*(\d+)\s*\]\s*/, " ");
  const genMatch = (used.makeModel || "").match(/\[\s*(\d+)\s*\]/);
  const generation = genMatch ? genMatch[1] : "";
  // Combine make and derivative, e.g. "CARRERA CABRIOLET" + "GTS 2dr PDK" => "Carrera GTS Cabriolet"
  let carName = "";
  if (used.makeModel) {
    let body = makeM.replace(/^911\s*/i, "").replace(/\s*-\s*\d{4}\s*$/, "").trim();
    // Insert derivative trim type (GTS, S, T) ahead of "Cabriolet"
    let der = (used.derivative || "").split(/[-\d]/)[0].trim(); // e.g. "GTS"
    if (der) {
      // Capitalise body words
      const titled = body.toLowerCase().replace(/\b\w/g, c => c.toUpperCase());
      // If body has "Cabriolet", insert der before "Cabriolet"
      if (/Cabriolet/i.test(titled) && !new RegExp(der, "i").test(titled)) {
        carName = titled.replace(/Cabriolet/i, der + " Cabriolet");
      } else if (!new RegExp(der, "i").test(titled)) {
        carName = titled + " " + der;
      } else {
        carName = titled;
      }
    } else {
      carName = body.toLowerCase().replace(/\b\w/g, c => c.toUpperCase());
    }
    if (generation && !carName.startsWith(generation)) carName = generation + " " + carName;
  }
  const mapped = mapToParamModel(carName, generation, true);
  return {
    name: name,
    soldTo: "Individual",
    address: address,
    postCode: postCode || "",
    tel: used.mobile || "",
    email: used.email || "",
    regNo: used.regNo || "",
    mileage: used.mileage || 0,
    carModel: mapped,
    vatQualifying: used.vatQualifying || "No",
    deliveryDay: used.estimatedHandover ? parseInt(used.estimatedHandover.split("/")[0]) : 15,
    deliveryMonth: used.estimatedHandover ? monthName(parseInt(used.estimatedHandover.split("/")[1])) : "May",
    deliveryYear: used.estimatedHandover ? parseInt(used.estimatedHandover.split("/")[2]) : new Date().getFullYear(),
    invoiceDay: used.estimatedHandover ? parseInt(used.estimatedHandover.split("/")[0]) : 15,
    invoiceMonth: used.estimatedHandover ? monthName(parseInt(used.estimatedHandover.split("/")[1])) : "May",
    invoiceYear: used.estimatedHandover ? parseInt(used.estimatedHandover.split("/")[2]) : new Date().getFullYear(),
    usedCarPrice: used.basicPrice || 0,
    gtechniq: used.gtechniq || 0,
    warrantyMonths: used.warrantyMonths || 24,
    warrantyPrice: used.warrantyPrice || 0,
    assistanceMonths: used.assistMonths || 24,
    assistancePrice: used.assistPrice || 0,
    deposits: used.cashDeposit || 0,
    financeAmount: used.financeBalance || 0,
    expectedTotal: used.totalOTR
  };
}

function monthName(num) {
  const m = ["January","February","March","April","May","June","July","August","September","October","November","December"];
  return m[Math.max(0, Math.min(11, num - 1))];
}

