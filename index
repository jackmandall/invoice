// ===== UTILS =====
function b64ToArrayBuffer(b64) {
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  return bytes.buffer;
}

async function extractText(file) {
  const buf = await file.arrayBuffer();
  const pdf = await pdfjsLib.getDocument({data: buf}).promise;
  let text = "";
  for (let p = 1; p <= pdf.numPages; p++) {
    const page = await pdf.getPage(p);
    const content = await page.getTextContent();
    // Reconstruct lines using y position
    const items = content.items;
    let lastY = null;
    let line = "";
    const lines = [];
    for (const it of items) {
      const y = it.transform[5];
      if (lastY !== null && Math.abs(y - lastY) > 2) {
        lines.push(line);
        line = "";
      }
      line += it.str + " ";
      lastY = y;
    }
    if (line) lines.push(line);
    text += lines.join("\n") + "\n";
  }
  return text;
}

function classify(text) {
  if (/Build Sheet Retail/i.test(text)) return "build";
  if (/New Vehicle Order Form/i.test(text)) return "new-order";
  if (/Vehicle Order Form/i.test(text) && /Order ID/i.test(text) && /New\/Used/i.test(text)) return "used-order";
  return "unknown";
}

function num(s) {
  if (s == null) return 0;
  const cleaned = String(s).replace(/[£,\s]/g, "");
  const n = parseFloat(cleaned);
  return isNaN(n) ? 0 : n;
}

function findMatch(text, regex) {
  const m = text.match(regex);
  return m ? m[1].trim() : "";
}

// ===== EXTRACTION =====
function extractNewOrder(text) {
  const d = {};
  d.name = findMatch(text, /Name:\s*([A-Z][A-Za-z\s\.\-]+?)(?:\n|Company Name)/);
  // Address block - between "Address:" and "Tel"
  const addrM = text.match(/Address:\s*([\s\S]+?)(?:Tel \(Home\)|Tel \(Mob\)|Telephone)/);
  if (addrM) {
    d.address = addrM[1].split(/\n/).map(s => s.trim()).filter(s => s && !/Great Britain/i.test(s));
  } else { d.address = []; }
  d.tel = findMatch(text, /Tel \(Mob\):\s*(\+?[\d\s]+)/);
  d.email = findMatch(text, /E-mail:\s*(\S+@\S+)/);
  d.model = findMatch(text, /Model:\s*([^\n\u00a3]+?)\s*\u00a3/);
  if (!d.model) d.model = findMatch(text, /Model:\s*([^\n]+)/);
  d.exteriorColour = findMatch(text, /Exterior Colour:\s*([^\n]+)/);
  d.trimColour = findMatch(text, /Trim Colour:\s*([^\n]+)/);
  d.modelPrice = num(findMatch(text, /Model:[^\n]+\u00a3\s*([\d,\.]+)/));
  d.vehicleOptions = num(findMatch(text, /Vehicle Optional Equipment[^\n]*?\u00a3\s*([\d,\.]+)/));
  d.dealerFittedTaxable = num(findMatch(text, /Dealer Fitted Options[^\n]*Taxable[^\n]*?\u00a3\s*([\d,\.]+)/));
  d.dealerDeductionsTaxable = num(findMatch(text, /Dealer Deductions[^\n]*Taxable[^\n]*?\u00a3\s*([\d,\.]+)/));
  d.vat = num(findMatch(text, /VAT @ 20%[^\n]*?\u00a3\s*([\d,\.]+)/));
  d.dealerFittedNonTaxable = num(findMatch(text, /Dealer Fitted Options[^\n]*Non Taxable[^\n]*?\u00a3\s*([\d,\.]+)/));
  d.totalPrice = num(findMatch(text, /\nPrice\s*\u00a3\s*([\d,\.]+)/));
  d.deposit = num(findMatch(text, /Deposit:\s*\u00a3\s*([\d,\.]+)/));
  d.rfl = num(findMatch(text, /\nRFL\s*\u00a3\s*([\d,\.]+)/));
  d.regFee = num(findMatch(text, /Reg Fee\s*\u00a3\s*([\d,\.]+)/));
  return d;
}

function extractBuildSheet(text) {
  const d = {};
  // Get customer name (line after "Customer")
  const custM = text.match(/Customer\s*\n\s*([A-Z][A-Za-z\s\.\-]+)/);
  d.customerName = custM ? custM[1].trim() : "";
  // Get model row: MTYP COLOR ... VIN
  const modelRowM = text.match(/([0-9A-Z]{6,})\s+[0-9A-Z]{6}\s+\S+\s+(WP0[A-Z0-9]+)/);
  if (modelRowM) {
    d.mtyp = modelRowM[1];
    d.vin = modelRowM[2];
  }
  // Generation from mtyp
  if (d.mtyp) {
    if (d.mtyp.startsWith("992")) d.generation = "992";
    else if (d.mtyp.startsWith("991")) d.generation = "991";
    else if (d.mtyp.startsWith("982")) d.generation = "982";
    else if (d.mtyp.startsWith("981")) d.generation = "981";
    else if (d.mtyp.startsWith("Y1")) d.generation = "Taycan";
    else d.generation = "";
  }
  // Get base model line (pos 1)
  const baseLineM = text.match(/1\s+[0-9A-Z]+\s+([^\n]+?)\s+([\d,\.]+)\s*\n/);
  if (baseLineM) {
    d.modelName = baseLineM[1].trim().replace(/^911\s+/, ""); // strip "911 " prefix
    d.basePrice = num(baseLineM[2]);
  }
  d.totalWithOptions = num(findMatch(text, /Total with options\s+([\d,\.]+)/));
  d.discount = num(findMatch(text, /Discount\*?\s+-?([\d,\.]+)/));
  if (d.discount > 0) d.discount = -d.discount;
  d.netPrice = num(findMatch(text, /Total Net Price\s+([\d,\.]+)/));
  d.taxes = num(findMatch(text, /Taxes\*?\*?\s+([\d,\.]+)/));
  d.grossPrice = num(findMatch(text, /Total Gross Price\s+([\d,\.]+)/));
  return d;
}

function extractUsedOrder(text) {
  const d = {};
  // Customer name - in "Supply To" section, prefixed by Mr/Mrs/Ms
  const supplyM = text.match(/Supply To[\s\S]+?\n\s*(M[rs]+\.?\s+[A-Z][A-Za-z\s\.\-]+)/);
  d.name = supplyM ? supplyM[1].trim() : "";
  // Address - lines after name, before contact details / next section
  const addrSec = text.match(/Supply To[\s\S]+?M[rs]+\.?\s+[A-Z][A-Za-z\s\.\-]+\n([\s\S]+?)(?:Contact Details|Financed By|Vehicle Information)/);
  if (addrSec) {
    d.addressLines = addrSec[1].split(/\n/).map(s => s.trim()).filter(s => s && s.length > 2);
  } else { d.addressLines = []; }
  d.mobile = findMatch(text, /Mobile 1:\s*([\d\s\+]+?)\s+(?:Email|\n)/);
  d.email = findMatch(text, /Email:\s*(\S+@\S+)/);
  d.newUsed = findMatch(text, /New\/Used:\s*(\S+)/);
  d.makeModel = findMatch(text, /Make\/Model:\s*([^\n]+?)(?:\s*-\s*\d{4})?\s*\n/);
  d.derivative = findMatch(text, /Derivative:\s*([^\n]+)/);
  d.regNo = findMatch(text, /Reg No\.\s*([A-Z0-9\s]+?)(?:\s|\n)/);
  d.regDate = findMatch(text, /Date of Reg:\s*([\d\/]+)/);
  d.mileage = num(findMatch(text, /Mileage:\s*(\d+)/));
  d.vatQualifying = findMatch(text, /VAT Qualifying:\s*(\S+)/);
  d.vin = findMatch(text, /VIN No\.\s*(\S+)/);
  d.stockNo = findMatch(text, /Stock No\.\s*(\S+)/);
  d.salesPerson = findMatch(text, /Sales Person:\s*([^\n]+?)\s+Source/);
  d.estimatedHandover = findMatch(text, /Estimated Handover:\s*([\d\/]+)/);
  d.basicPrice = num(findMatch(text, /Vehicle Basic Price\s*\u00a3\s*([\d,\.]+)/));
  d.factoryOptions = num(findMatch(text, /Factory Fitted Options\s*\u00a3\s*([\d,\.]+)/));
  d.retailerOptions = num(findMatch(text, /Retailer Options\s*\u00a3\s*([\d,\.]+)/));
  d.subTotal = num(findMatch(text, /Sub-Total\s*\u00a3\s*([\d,\.]+)/));
  d.vat = num(findMatch(text, /VAT @ 20%\s*\u00a3\s*([\d,\.]+)/));
  d.nonVatOptions = num(findMatch(text, /Non VAT Options\s*\u00a3\s*([\d,\.]+)/));
  d.totalOTR = num(findMatch(text, /Total on the Road Price\s*\u00a3\s*([\d,\.]+)/));
  d.cashDeposit = num(findMatch(text, /Cash Deposit Paid Today\s*\u00a3\s*([\d,\.]+)/));
  d.financeBalance = num(findMatch(text, /Balance Due From Finance Company\s*\u00a3\s*([\d,\.]+)/));
  d.customerBalance = num(findMatch(text, /Balance Due From Customer\s*\u00a3\s*([\d,\.]+)/));
  // Retailer Options breakdown
  d.gtechniq = num(findMatch(text, /Gtechniq[^\n]*?\u00a3\s*([\d,\.]+)/));
  d.assistMonths = parseInt(findMatch(text, /Porsche Assist\s*-\s*(\d+)\s*months/) || "0");
  d.assistPrice = num(findMatch(text, /Porsche Assist[^\n]*?\u00a3\s*([\d,\.]+)/));
  // Warranty line: e.g. "911 - 24 months - 24 Months £2,220.00"
  d.warrantyMonths = parseInt(findMatch(text, /\b911\s*-\s*(\d+)\s*months/) || "0");
  d.warrantyPrice = num(findMatch(text, /\b911\s*-\s*\d+\s*months[^\n]*?\u00a3\s*([\d,\.]+)/));
  return d;
}

// Map Porsche model name to Parameters Sheet model
function mapToParamModel(name, generation, isUsed) {
  if (!name) return "";
  let cleaned = name.replace(/^Porsche\s+/i, "").replace(/\s*\[\d+\]\s*/, " ");
  // Insert generation prefix if missing
  if (generation && !cleaned.startsWith(generation)) {
    cleaned = generation + " " + cleaned.replace(/^911\s+/i, "");
  }
  cleaned = cleaned.replace(/\s+/g, " ").trim();
  // Try exact match first
  for (const m of MODELS) {
    if (m.toLowerCase().trim() === cleaned.toLowerCase()) return m;
  }
  // Try fuzzy match: contains key words
  const tokens = cleaned.toLowerCase().split(/\s+/).filter(t => t.length > 1);
  let best = null, bestScore = 0;
  for (const m of MODELS) {
    const mt = m.toLowerCase();
    const s = tokens.filter(t => mt.includes(t)).length;
    if (s > bestScore) { bestScore = s; best = m; }
  }
  return bestScore >= 2 ? best : cleaned;
}

