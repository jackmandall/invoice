  ws.getCell("E15").value = d.carModel || null;
  ws.getCell("G22").value = d.vatQualifying || "No";
  ws.getCell("B17").value = d.deliveryDay; ws.getCell("C17").value = d.deliveryMonth; ws.getCell("D17").value = d.deliveryYear;
  ws.getCell("B18").value = d.invoiceDay; ws.getCell("C18").value = d.invoiceMonth; ws.getCell("D18").value = d.invoiceYear;
  ws.getCell("C21").value = d.usedCarPrice;
  // Determine where warranty/assistance go
  if (onFinance) {
    // Main warranty/assistance set to None, value on supplementary
    ws.getCell("B22").value = "None";
    ws.getCell("B23").value = "None";
    ws.getCell("L48").value = d.warrantyPrice;
    ws.getCell("L49").value = d.assistancePrice;
  } else {
    // Cash deal: warranty/assistance on main invoice
    ws.getCell("B22").value = d.warrantyTerm || "None";
    ws.getCell("B23").value = d.assistanceTerm || "None";
    ws.getCell("L48").value = 0;
    ws.getCell("L49").value = 0;
  }
  ws.getCell("N48").value = 0;
  ws.getCell("N49").value = 0;
  ws.getCell("C30").value = 0;
  ws.getCell("C43").value = d.gtechniq;
  ws.getCell("C49").value = 0;
  for (let r = 34; r <= 40; r++) ws.getCell(`C${r}`).value = 0;
  // Clear PX
  const pxClears = ["L22","L23","L24","L25","L26","L27","L28","L32","L33","L36","L38","L39"];
  pxClears.forEach(c => { ws.getCell(c).value = null; });
  ws.getCell("L41").value = {formula: "C52"};
  ws.getCell("L42").value = d.deposits;
  ws.getCell("L44").value = d.financeAmount;
}

// ===== EVENT WIRING =====
const dz = $("#dropzone");
const fi = $("#fileInput");
dz.addEventListener("click", () => fi.click());
dz.addEventListener("dragover", e => { e.preventDefault(); dz.classList.add("dragover"); });
dz.addEventListener("dragleave", () => dz.classList.remove("dragover"));
dz.addEventListener("drop", e => {
  e.preventDefault();
  dz.classList.remove("dragover");
  handleFiles(e.dataTransfer.files);
});
fi.addEventListener("change", () => handleFiles(fi.files));

async function handleFiles(fileList) {
  for (const f of fileList) {
    if (!/\.pdf$/i.test(f.name)) continue;
    showStatus(`Reading ${f.name}...`, "warn");
    const text = await extractText(f);
    const type = classify(text);
    let data = {};
    if (type === "new-order") data = extractNewOrder(text);
    else if (type === "build") data = extractBuildSheet(text);
    else if (type === "used-order") data = extractUsedOrder(text);
    files.push({name: f.name, file: f, text, type, data});
  }
  hideStatus();
  renderFiles();
  classifyAndPrepare();
}

$("#generateBtn").addEventListener("click", () => {
  generate().catch(err => {
    console.error(err);
    showStatus("Error: " + err.message, "err");
  });
});

$("#resetBtn").addEventListener("click", () => {
  files = []; mode = null; reviewData = {}; onFinance = false;
  renderFiles();
  $("#reviewPanel").classList.add("hidden");
  hideStatus();
  fi.value = "";
});
</script>
