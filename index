      ${d.expectedTotal ? `<div class="row" style="color:var(--muted); margin-top:6px;"><span>PDF expected Price</span><span>${gbp(d.expectedTotal)}</span></div>` : ""}
    `;
  } else {
    const subtotal = d.usedCarPrice + d.gtechniq;
    const vatOnGtechniq = d.gtechniq * 0.2;
    const main = subtotal + vatOnGtechniq;
    const supp = d.warrantyPrice + d.assistancePrice;
    const grand = main + supp;
    t.innerHTML = `
      <div class="row"><span>Used Car Price</span><strong>${gbp(d.usedCarPrice)}</strong></div>
      <div class="row"><span>Gtechniq</span><strong>${gbp(d.gtechniq)}</strong></div>
      <div class="row"><span>VAT on options</span><strong>${gbp(vatOnGtechniq)}</strong></div>
      <div class="row"><span>Main invoice</span><strong>${gbp(main)}</strong></div>
      <div class="row"><span>Supplementary (Warranty + Assistance)</span><strong>${gbp(supp)}</strong></div>
      <div class="row grand"><span>GRAND TOTAL</span><strong>${gbp(grand)}</strong></div>
      <div class="row"><span>Less Deposit</span><strong>${gbp(d.deposits)}</strong></div>
      <div class="row"><span>Balance Due</span><strong>${gbp(grand - d.deposits)}</strong></div>
      ${d.expectedTotal ? `<div class="row" style="color:var(--muted); margin-top:6px;"><span>PDF expected OTR</span><span>${gbp(d.expectedTotal)}</span></div>` : ""}
    `;
  }
}

// ===== EXCEL GENERATION =====
async function generate() {
  showStatus("Loading template...", "warn");
  const wb = new ExcelJS.Workbook();
  await wb.xlsx.load(b64ToArrayBuffer(TEMPLATE_B64));
  if (mode === "new") {
    populateNew(wb, reviewData);
    // Keep New Cars + supporting (RFL drives VED, CONTROL SHEET drives VAT, Parameters Sheet drives lookups)
    stripTabs(wb, ["Approved Cars", "Used Car Order Form"]);
  } else {
    populateUsed(wb, reviewData);
    // Keep Approved Cars + supporting (CONTROL SHEET drives VAT/warranty, Parameters Sheet drives lookups)
    // Drop RFL - its formulas reference New Cars cells and are not used by Approved Cars
    stripTabs(wb, ["New Cars", "Used Car Order Form", "RFL"]);
  }
  showStatus("Writing file...", "warn");
  const buf = await wb.xlsx.writeBuffer();
  const blob = new Blob([buf], {type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"});
  const a = document.createElement("a");
  const safeName = (reviewData.name || "Customer").replace(/[^\w\s\-]/g, "").trim();
  const model = (reviewData.carModel || "Vehicle").replace(/[^\w\s\-]/g, "").trim();
  const tag = mode === "new" ? "NEW" : "USED";
  a.download = `Invoice Request - ${safeName} - ${model} (${tag}).xlsx`;
  a.href = URL.createObjectURL(blob);
  a.click();
  URL.revokeObjectURL(a.href);
  showStatus("Done. File downloaded.", "ok");
}

function stripTabs(wb, names) {
  for (const name of names) {
    const ws = wb.getWorksheet(name);
    if (ws) {
      try { wb.removeWorksheet(ws.id); } catch (e) { console.warn("Could not remove", name, e); }
    }
  }
}

